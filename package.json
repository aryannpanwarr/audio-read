{
  "name": "audio-read",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "audiobook": "node scripts/pc-audiobook.mjs",
    "desktop": "electron desktop/main.mjs",
    "setup:cuda": "bash scripts/setup-cuda-runtime.sh",
    "desktop:cuda": "LD_LIBRARY_PATH=\"$PWD/.cuda-libs/nvidia/cublas/lib:$PWD/.cuda-libs/nvidia/cuda_runtime/lib:$PWD/.cuda-libs/nvidia/cudnn/lib:$PWD/.cuda-libs/nvidia/cufft/lib:$PWD/.cuda-libs/nvidia/curand/lib:$PWD/.cuda-libs/nvidia/cuda_nvrtc/lib:$LD_LIBRARY_PATH\" electron desktop/main.mjs"
  },
  "dependencies": {
    "kokoro-js": "^1.2.1",
    "pdfjs-dist": "^6.0.227",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^42.4.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
